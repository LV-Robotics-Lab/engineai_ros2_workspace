<mujoco model="iron_ball_drop">
    <!-- ========================================== -->
    <!-- 铁球自由落体冲击力分析模型 -->
    <!-- ========================================== -->
    
    <!-- 编译器设置 -->
    <compiler angle="radian" coordinate="local" discardvisual="false" autolimits="true"/>
    <!-- angle="radian": 角度单位为弧度 -->
    <!-- coordinate="local": 使用局部坐标系 -->
    <!-- discardvisual="false": 保留视觉元素 -->
    <!-- autolimits="true": 自动设置关节限制 -->
    
    <!-- 仿真选项 -->
    <option gravity="0 0 -9.81" integrator="RK4" timestep="0.00001" tolerance="1e-12" cone="elliptic"/>
    <!-- gravity="0 0 -9.81": 重力加速度，z轴向下9.81 m/s² -->
    <!-- integrator="RK4": 使用四阶龙格库塔积分器 -->
    <!-- timestep="0.00001": 仿真时间步长，0.01毫秒，用于高精度冲击力分析 -->
    <!-- tolerance="1e-12": 数值求解容差，确保高精度计算 -->
    <!-- cone="elliptic": 使用椭圆锥接触模型，提供更精确的接触力计算 -->
    
    <!-- 可视化设置 -->
    <visual>
        <!-- 接触点可视化设置 -->
        <rgba contactpoint="1.0 0.0 0.0 1.0" contactforce="0.8 0.36 0.36 1" 
               contactfriction="0.8 0.36 0.36 1" contacttorque="0.8 0.36 0.36 1" 
               contactgap="0.8 0.36 0.36 1" haze="0.15 0.25 0.35 1"/>
        <!-- contactpoint: 接触点颜色，红色 -->
        <!-- contactforce: 接触力颜色，浅红色 -->
        <!-- contactfriction: 摩擦力颜色，浅红色 -->
        <!-- contacttorque: 接触力矩颜色，浅红色 -->
        <!-- contactgap: 接触间隙颜色，浅红色 -->
        <!-- haze: 雾化效果颜色，蓝灰色 -->
        
        <scale contactwidth="0.003" contactheight="0.005" forcewidth="0.02"/>
        <!-- contactwidth: 接触点宽度，3毫米 -->
        <!-- contactheight: 接触点高度，5毫米 -->
        <!-- forcewidth: 力向量宽度，2厘米 -->
        
        <!-- 光照和渲染设置 -->
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <!-- diffuse: 漫反射光强度 -->
        <!-- ambient: 环境光强度 -->
        <!-- specular: 镜面反射光强度 -->
        
        <global azimuth="150" elevation="-20"/>
        <!-- azimuth: 方位角，150度 -->
        <!-- elevation: 仰角，-20度（向下看） -->
        
        <quality shadowsize="0"/>
        <!-- shadowsize: 阴影大小，0表示无阴影 -->
    </visual>

    <!-- 资源定义 -->
    <asset>
        <!-- 材料定义 -->
        <material name="iron" rgba="0.4 0.4 0.4 1" specular="0.3" reflectance="0.1"/>
        <!-- name="iron": 铁材料名称 -->
        <!-- rgba: 颜色，灰色，不透明度1.0 -->
        <!-- specular: 镜面反射系数，0.3 -->
        <!-- reflectance: 反射率，0.1 -->
        
        <!-- 地面纹理 -->
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" 
                 rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" 
                 width="1000" height="1000"/>
        <!-- type="2d": 2D纹理类型 -->
        <!-- name="groundplane": 纹理名称 -->
        <!-- builtin="checker": 内置棋盘格纹理 -->
        <!-- mark="edge": 边缘标记 -->
        <!-- rgb1/rgb2: 棋盘格两种颜色，蓝灰色系 -->
        <!-- markrgb: 边缘标记颜色，白色 -->
        <!-- width/height: 纹理尺寸，1000x1000像素 -->
        
        <material name="groundplane" texture="groundplane" texuniform="true" 
                  texrepeat="5 5" reflectance="0"/>
        <!-- name="groundplane": 地面平面材料名称 -->
        <!-- texture: 使用的纹理名称 -->
        <!-- texuniform="true": 纹理均匀分布 -->
        <!-- texrepeat="5 5": 纹理重复次数，5x5 -->
        <!-- reflectance="0": 无反射 -->
    </asset>

    <!-- 几何体和关节的默认设置 -->
    <default>
        <!-- 铁质物体的默认设置 -->
        <default class="iron_object">
            <geom density="7860" friction="0.5 0.005 0.0001" condim="6" 
                   solimp="0.9 0.95" solref="0.0005 1" material="iron"/>
            <!-- density="7860": 密度，铁的标准密度7860 kg/m³ -->
            <!-- friction="0.5 0.005 0.0001": 摩擦系数，滑动/滚动/旋转摩擦 -->
            <!-- condim="6": 接触维度，6表示完整3D接触, 3表示平面接触, 4表示圆柱接触 -->

            <!-- ========================================== -->
            <!-- solimp 参数详解 (d0, dwidth, width, midpoint, power) -->
            <!-- ========================================== -->
            <!-- d0: 当 r = 0（无违反）时的阻抗值 -->
            <!-- dwidth: 当 r = width 时的阻抗值 -->
            <!-- width: 从 r = 0 到 r = width 是阻抗函数变化的范围，超过这个范围 d(r) 保持不变 -->
            <!-- midpoint: sigmoid 曲线的拐点（在 width 范围内），值域为 [0, 1], 值越大越凹 -->
            <!-- power: 幂次，控制接触力曲线的形状，必须 ≥1，1 表示线性变化，越大越陡峭 -->
            <!-- solimp 自动补全 = (0.9, 0.95, 0.001, 0.5, 2) -->
            <!-- 参考文档: https://mujoco.readthedocs.io/en/stable/modeling.html#csolver -->
            <!-- ========================================== -->

            <!-- ========================================== -->
            <!-- solref 参数详解 -->
            <!-- ========================================== -->
            <!-- solref 有两种格式，基于数值的正负号： -->
            <!-- -->
            <!-- 1. 正值格式 (timeconstant, dampratio): -->
            <!--    - timeconst (s): 时间常数，表示“约束需要多快消除违反” -->
            <!--    - dampratio: 阻尼比，表示响应是振荡的（<1）、临界的 (=1)、或过阻尼的 (>1) -->
            <!-- -->
            <!--    示例: solref="0.02 1" -->
            <!--    表示在大约 0.02 秒内消除约束冲突，具有临界阻尼（无振荡） -->
            <!-- -->
            <!-- 2. 负值格式 (-stiffness, -damping): -->
            <!--    - stiffness (N/m): 约束的刚度 -->
            <!--    - damping (Ns/m): 约束的阻尼值 -->
            <!-- -->
            <!--    示例: solref="-10000 -20" -->
            <!--    表示刚度为10000 N/m，阻尼为20 Ns/m的刚性约束 -->
            <!--    数值越大，约束越刚性，弹性越小. 如果你设 -damping = 0，就会变成完全弹性碰撞（无能量损失），适合反弹模拟。-->
            <!-- ========================================== -->

            <!-- solref="0.0005 1": 中等刚度接触参数，产生适中的冲击时间 -->
            <!-- material="iron": 使用铁材料 -->
        </default>
        
        <!-- 地面物体的默认设置 -->
        <default class="ground_object">
            <geom density="7860" friction="0.8 0.005 0.0001" condim="6" 
                   solimp="0.9 0.95" solref="0.0005 1" material="iron"/>
            <!-- density="7860": 密度，铁的标准密度7860 kg/m³ -->
            <!-- friction="0.5 0.005 0.0001": 摩擦系数，滑动/滚动/旋转摩擦 -->
            <!-- condim="6": 接触维度，6表示完整3D接触 -->
            <!-- solimp="0.9 0.95": 求解器参数，影响接触力计算精度 -->
            <!-- solref="0.0005 1": 中等刚度接触参数，产生适中的冲击时间 -->
            <!-- material="iron": 使用铁材料 -->
        </default>
        

    </default>

    <!-- 世界体 - 主仿真环境 -->
    <worldbody>
        <!-- 光照 -->
        <light name="spotlight" pos="0 0 5" dir="0 0 -1" directional="true"/>
        <!-- name="spotlight": 聚光灯名称 -->
        <!-- pos="0 0 5": 光源位置，在z轴上方5米 -->
        <!-- dir="0 0 -1": 光照方向，向下 -->
        <!-- directional="true": 方向性光源 -->
        
        <!-- 地面平面 -->
        <geom name="ground" type="plane" size="1 1 0.3" material="groundplane" 
               class="ground_object"/>
        <!-- name="ground": 地面几何体名称 -->
        <!-- type="plane": 平面几何体类型 -->
        <!-- size="1 1 0.3": 平面尺寸，1x1米，厚度0.1米 -->
        <!-- material="groundplane": 使用地面平面材料 -->
        <!-- class="ground_object": 使用地面物体类 -->
        
        <!-- 地面传感器阵列 - 10cmx10cm区域，密度1cm -->
        <!-- 覆盖范围：-0.05到0.05米，总共11x11=121个传感器 -->
        <site name="ground_contact_center" pos="0 0 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_n1" pos="0 0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_n2" pos="0 0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_n3" pos="0 0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_n4" pos="0 0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_n5" pos="0 0.05 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_s1" pos="0 -0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_s2" pos="0 -0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_s3" pos="0 -0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_s4" pos="0 -0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_s5" pos="0 -0.05 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_e1" pos="0.01 0 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_e2" pos="0.02 0 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_e3" pos="0.03 0 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_e4" pos="0.04 0 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_e5" pos="0.05 0 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_w1" pos="-0.01 0 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_w2" pos="-0.02 0 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_w3" pos="-0.03 0 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_w4" pos="-0.04 0 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_w5" pos="-0.05 0 0" size="0.005" rgba="1 0 0 1"/>
        <!-- 对角线传感器 -->
        <site name="ground_contact_ne1" pos="0.01 0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_ne2" pos="0.02 0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_ne3" pos="0.03 0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_ne4" pos="0.04 0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_ne5" pos="0.05 0.05 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_nw1" pos="-0.01 0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_nw2" pos="-0.02 0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_nw3" pos="-0.03 0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_nw4" pos="-0.04 0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_nw5" pos="-0.05 0.05 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_se1" pos="0.01 -0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_se2" pos="0.02 -0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_se3" pos="0.03 -0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_se4" pos="0.04 -0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_se5" pos="0.05 -0.05 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_sw1" pos="-0.01 -0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_sw2" pos="-0.02 -0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_sw3" pos="-0.03 -0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_sw4" pos="-0.04 -0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_sw5" pos="-0.05 -0.05 0" size="0.005" rgba="1 0 0 1"/>
        <!-- 填充其他位置的传感器 -->
        <site name="ground_contact_01" pos="0.01 0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_02" pos="0.01 0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_03" pos="0.01 0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_04" pos="0.01 -0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_05" pos="0.01 -0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_06" pos="0.01 -0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_07" pos="0.02 0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_08" pos="0.02 0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_09" pos="0.02 0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_10" pos="0.02 -0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_11" pos="0.02 -0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_12" pos="0.02 -0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_13" pos="0.03 0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_14" pos="0.03 0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_15" pos="0.03 0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_16" pos="0.03 -0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_17" pos="0.03 -0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_18" pos="0.03 -0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_19" pos="0.04 0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_20" pos="0.04 0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_21" pos="0.04 0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_22" pos="0.04 -0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_23" pos="0.04 -0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_24" pos="0.04 -0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_25" pos="0.05 0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_26" pos="0.05 0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_27" pos="0.05 0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_28" pos="0.05 0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_29" pos="0.05 -0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_30" pos="0.05 -0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_31" pos="0.05 -0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_32" pos="0.05 -0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_33" pos="-0.01 0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_34" pos="-0.01 0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_35" pos="-0.01 0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_36" pos="-0.01 -0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_37" pos="-0.01 -0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_38" pos="-0.01 -0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_39" pos="-0.02 0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_40" pos="-0.02 0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_41" pos="-0.02 0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_42" pos="-0.02 -0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_43" pos="-0.02 -0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_44" pos="-0.02 -0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_45" pos="-0.03 0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_46" pos="-0.03 0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_47" pos="-0.03 0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_48" pos="-0.03 -0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_49" pos="-0.03 -0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_50" pos="-0.03 -0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_51" pos="-0.04 0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_52" pos="-0.04 0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_53" pos="-0.04 0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_54" pos="-0.04 -0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_55" pos="-0.04 -0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_56" pos="-0.04 -0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_57" pos="-0.05 0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_58" pos="-0.05 0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_59" pos="-0.05 0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_60" pos="-0.05 0.04 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_61" pos="-0.05 -0.01 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_62" pos="-0.05 -0.02 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_63" pos="-0.05 -0.03 0" size="0.005" rgba="1 0 0 1"/>
        <site name="ground_contact_64" pos="-0.05 -0.04 0" size="0.005" rgba="1 0 0 1"/>
        
        <!-- 铁球体 -->
        <!-- name="iron_ball": 铁球体名称 -->
        <!-- 0.26kg铁球: pos="0 0 1.0": 初始位置，在z轴上方0.42米 -->
        <!-- 5kg铁球: pos="0 0 1.0": 初始位置，在z轴上方1米 -->
        <body name="iron_ball" pos="0 0 1.0">
            
            <!-- 自由关节，允许6自由度运动 -->
            <joint type="free"/>
            <!-- type="free": 自由关节类型 -->
            
            <!-- 球体几何 - 铁球质量-半径对应关系 -->
            <!-- 密度：7860 kg/m³ (铁的密度) -->
            <!-- 0.26kg铁球: 半径=0.020m (2.00cm) -->
            <!-- 1kg铁球: 半径=0.0316m (3.16cm) -->
            <!-- 2kg铁球: 半径=0.0398m (3.98cm) -->
            <!-- 3kg铁球: 半径=0.0456m (4.56cm) -->
            <!-- 4kg铁球: 半径=0.0502m (5.02cm) -->
            <!-- 5kg铁球: 半径=0.0534m (5.34cm) - 当前设置 -->
            <!-- 6kg铁球: 半径=0.0575m (5.75cm) -->
            <!-- 8kg铁球: 半径=0.0632m (6.32cm) -->
            <!-- 10kg铁球: 半径=0.0680m (6.80cm) -->
            <!-- 计算公式: 半径 = (3×重量/(4×π×7860))^(1/3) -->
            <geom name="ball_geom" type="sphere" size="0.0534" class="iron_object" 
                   rgba="0.3 0.3 0.3 1"/>
            <!-- name="ball_geom": 球体几何体名称 -->
            <!-- type="sphere": 球体几何体类型 -->
            <!-- size="0.0534": 球体半径，5.34厘米，对应5kg铁球 -->
            <!-- class="iron_object": 使用铁质物体类 -->
            <!-- rgba="0.3 0.3 0.3 1": 颜色，深灰色 -->
            

        </body>
    </worldbody>

    <!-- 接触对定义 - 中等刚度接触设置 -->
    <contact>
        <pair geom1="ground" geom2="ball_geom" solref="0.0005 1" solreffriction="0.0005 1"/>
        <!-- geom1="ground": 地面几何体 -->
        <!-- geom2="ball_geom": 球体几何体 -->
        <!-- solref="0.0005 1": 中等刚度接触参数，产生适中的冲击时间 -->
        <!-- solreffriction="0.0005 1": 中等摩擦刚度参数，提供适当的摩擦阻尼 -->
    </contact>

    <!-- 传感器定义 -->
    <sensor>
        <!-- 地面传感器阵列 - 121个触摸传感器 -->
        <touch name="touch_center" site="ground_contact_center"/>
