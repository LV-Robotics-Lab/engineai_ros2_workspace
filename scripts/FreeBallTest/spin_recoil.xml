<mujoco>
  <!-- ========================================== -->
  <!-- 旋转反冲测试模型 -->
  <!-- 用于测试球体旋转时的反冲效应 -->
  <!-- ========================================== -->
  
  <!-- 仿真选项 -->
  <option cone="elliptic" timestep="1e-4" integrator="implicitfast"/>
  <!-- cone="elliptic": 使用椭圆锥接触模型 -->
  <!-- timestep="1e-4": 时间步长0.1毫秒，高精度仿真 -->
  <!-- integrator="implicitfast": 使用快速隐式积分器 -->
  
  <!-- 可视化设置 -->
  <visual>
    <global elevation="0"/>
    <!-- elevation="0": 全局仰角设置为0度，水平视角 -->
  </visual>

  <!-- 资源定义 -->
  <asset>
    <!-- 地面网格纹理 -->
    <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300"/>
    <!-- name="grid": 网格纹理名称 -->
    <!-- type="2d": 2D纹理类型 -->
    <!-- builtin="checker": 内置棋盘格纹理 -->
    <!-- rgb1/rgb2: 棋盘格两种颜色，蓝灰色系 -->
    <!-- width/height: 纹理尺寸，300x300像素 -->
    
    <material name="grid" texture="grid" texrepeat="8 8" reflectance=".2"/>
    <!-- name="grid": 网格材料名称 -->
    <!-- texture="grid": 使用网格纹理 -->
    <!-- texrepeat="8 8": 纹理重复次数，8x8 -->
    <!-- reflectance=".2": 反射率20% -->
    
    <!-- 球体纹理 -->
    <texture name="ball" type="cube" builtin="checker" rgb1=".3 .3 .3" rgb2="1 1 1" width="30" height="30"/>
    <!-- name="ball": 球体纹理名称 -->
    <!-- type="cube": 立方体贴图纹理 -->
    <!-- builtin="checker": 内置棋盘格纹理 -->
    <!-- rgb1/rgb2: 棋盘格两种颜色，灰色和白色 -->
    <!-- width/height: 纹理尺寸，300x300像素 -->
    
    <material name="ball" texture="ball" texrepeat="8 8"/>
    <!-- name="ball": 球体材料名称 -->
    <!-- texture="ball": 使用球体纹理 -->
    <!-- texrepeat="8 8": 纹理重复次数，8x8 -->
  </asset>

  <!-- 世界体 - 主仿真环境 -->
  <worldbody>
    <!-- 地面平面 -->
    <geom name="floor" size=".2 .2 .01" type="plane" material="grid"/>
    <!-- name="floor": 地面几何体名称 -->
    <!-- size=".2 .2 .01": 平面尺寸，0.4x0.4米，厚度0.02米 -->
    <!-- type="plane": 平面几何体类型 -->
    <!-- material="grid": 使用网格材料 -->
    
    <!-- 垂直墙壁 -->
    <geom name="wall" size=".2 .2 .01" type="plane" material="grid" pos=".2 0 .2" zaxis="-1 0 0"/>
    <!-- name="wall": 墙壁几何体名称 -->
    <!-- size=".2 .2 .01": 平面尺寸，0.4x0.4米，厚度0.02米 -->
    <!-- type="plane": 平面几何体类型 -->
    <!-- material="grid": 使用网格材料 -->
    <!-- pos=".2 0 .2": 位置，x轴0.2米，z轴0.2米 -->
    <!-- zaxis="-1 0 0": z轴方向，指向-x方向，形成垂直墙 -->
    
    <!-- 光照设置 -->
    <light pos="0 0 .6"/>
    <!-- 主光源，位置在z轴上方0.6米 -->
    <light pos="-.6 0 .6" dir="1 0 -1"/>
    <!-- 辅助光源，位置在x轴-0.6米，z轴0.6米 -->
    <!-- dir="1 0 -1": 光照方向，指向x轴正方向，z轴负方向 -->
    
    <!-- 主球体 -->
    <body name="ball" pos="-.1 0 .2">
      <!-- name="ball": 主球体名称 -->
      <!-- pos="-.1 0 .2": 初始位置，x轴-0.1米，z轴0.2米 -->
      
      <freejoint/>
      <!-- 自由关节，允许6自由度运动 -->
      
      <geom name="ball" type="sphere" size=".02" material="ball" mass=".001"/>
      <!-- name="ball": 球体几何体名称 -->
      <!-- type="sphere": 球体几何体类型 -->
      <!-- size=".02": 球体半径，2厘米 -->
      <!-- material="ball": 使用球体材料 -->
      <!-- mass=".001": 质量，1克 -->
      
      <!-- 配重球体 -->
      <body name="ballast">
        <!-- name="ballast": 配重球体名称 -->
        
        <joint type="ball" stiffness="0.1" damping=".0001"/>
        <!-- type="ball": 球关节类型，允许3轴旋转 -->
        <!-- stiffness="0.1": 刚度，0.1 N⋅m/rad -->
        <!-- damping=".0001": 阻尼，0.0001 N⋅m⋅s/rad -->
        
        <geom name="ballast" type="sphere" size=".02" contype="0" conaffinity="0" mass=".01" group="3"/>
        <!-- name="ballast": 配重几何体名称 -->
        <!-- type="sphere": 球体几何体类型 -->
        <!-- size=".02": 球体半径，2厘米 -->
        <!-- contype="0": 接触类型0，不与地面接触 -->
        <!-- conaffinity="0": 接触亲和性0，不与墙壁接触 -->
        <!-- mass=".01": 质量，10克 -->
        <!-- group="3": 几何体组3，用于可视化分组 -->
      </body>
    </body>
  </worldbody>

  <!-- 默认接触设置 -->
  <default>
    <pair solref="-100000 0" solreffriction="0 -10000"/>
    <!-- solref="-100000 0": 求解器参考参数，高刚度接触 -->
    <!-- solreffriction="0 -10000": 摩擦求解器参数，高摩擦刚度 -->
  </default>

  <!-- 接触对定义 -->
  <contact>
    <pair geom1="floor" geom2="ball"/>
    <!-- 地面与主球体的接触 -->
    <pair geom1="wall" geom2="ball"/>
    <!-- 墙壁与主球体的接触 -->
  </contact>

  <!-- 关键帧定义 -->
  <keyframe>
    <key name="throw" qvel="1.3 0 0 0 0 0 0 0 0"/>
    <!-- name="throw": 投掷关键帧名称 -->
    <!-- qvel="1.3 0 0 0 0 0 0 0 0": 初始速度，x轴1.3 m/s -->
    <!-- 格式：[x_vel, y_vel, z_vel, x_ang_vel, y_ang_vel, z_ang_vel, ...] -->
  </keyframe>
</mujoco>
